# Copy to .env and edit. Every setting is optional.

# Port and address to listen on
PORT=3000
HOST=0.0.0.0

# ---- Sign-in -------------------------------------------------------------
# Google sign-in (see docs/GOOGLE_SIGNIN.md). Needs both ID and secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google accounts allowed to sign in (comma-separated; @domain.com = whole Workspace domain)
ADMIN_EMAILS=
# Public address you open the dashboard on, e.g. https://status.example.com
# (Google requires https on a real domain, or http://localhost)
PUBLIC_URL=

# Admin password / API token. If empty, one is generated into data/admin-password.txt
ADMIN_PASSWORD=
# Allow password sign-in. Default: on without Google, off with Google.
#PASSWORD_LOGIN=true

# ---- Other ---------------------------------------------------------------
# Where monitors, history and settings are stored (relative to this folder)
DATA_DIR=./data

# Site title used on first start (change later in Settings)
SITE_TITLE=Uptime Monitor

# First-start default: false = login required to view the dashboard
PUBLIC_DASHBOARD=true

# Comma-separated webhook URLs (Discord, Slack, ntfy, or any JSON endpoint)
NOTIFY_WEBHOOK_URL=

# Set to true when behind a reverse proxy (Caddy, nginx, Traefik, Cloudflare Tunnel)
TRUST_PROXY=false

# Allow the dashboard inside an iframe (Homepage, Heimdall, Home Assistant, ...)
ALLOW_EMBED=false
